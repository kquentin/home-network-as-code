#!ipxe
# embedded in the iPXE binary served over TFTP.

:start
dhcp || goto retry
iseq ${gateway} 10.10.10.1 && goto homeserver ||
iseq ${gateway} 10.10.30.1 && goto lab ||
goto unknown

:homeserver
set images https://github.com/nix-community/nixos-images/releases/download/nixos-26.05
initrd https://raw.githubusercontent.com/kquentin/home-network-as-code/main/keys/admin.pub /ssh/authorized_keys mode=400 || goto failed
chain --autofree ${images}/netboot-x86_64-linux.ipxe || goto failed
goto failed

:lab
chain --autofree http://10.10.30.1:8080/debian.ipxe || goto failed
goto failed

:retry
echo DHCP failed, retrying in 5s
sleep 5
goto start

:unknown
echo No installer for gateway ${gateway}
goto shell

:failed
echo Could not load the installer for gateway ${gateway}
goto shell

:shell
echo Dropping to the iPXE shell.
shell
